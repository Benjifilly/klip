{
  "name": "@klip/desktop",
  "version": "0.1.0",
  "description": "Klip desktop client — Electron + React + Tailwind.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "electron-updater": "^6.8.9",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "app.klip.desktop",
    "productName": "Klip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**"
    ],
    "protocols": [
      {
        "name": "Klip",
        "schemes": [
          "klip"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Benjifilly",
        "repo": "klip"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  }
}
