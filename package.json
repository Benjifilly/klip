{
  "name": "klip",
  "version": "0.1.0",
  "private": true,
  "description": "Instant, end-to-end encrypted clipboard sync between your devices.",
  "license": "MIT",
  "workspaces": [
    "server",
    "client",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -k -s first \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:client": "npm run build --workspace client",
    "dist:client": "npm run dist --workspace client",
    "lint": "eslint .",
    "test": "node tests/unit.cjs && node tests/e2e.cjs && npm run test --workspace mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "shell-quote": ">=1.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.61.0"
  }
}
